{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fitia-chatgpt-cloudflare",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "vars": {
    "TIMEZONE": "America/Asuncion"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitia-chatgpt-data",
      "migrations_dir": "migrations"
    }
  ]
}

