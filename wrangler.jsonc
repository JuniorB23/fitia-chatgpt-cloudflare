{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "fitia-chatgpt-cloudflare",
  "main": "src/worker.mjs",
  "compatibility_date": "2026-11-15",
  "workers_dev": true,
  "vars": {
    "TIMEZONE": "America/Asuncion"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "fitia-chatgpt-data",
      "database_id": "02c5522f-6457-40d1-bf71-af3751ed5f89",
      "migrations_dir": "migrations"
    }
  ]
}

